// Self-contained threshold fixture. Expected output: TestPassed=true.
let UserThreshold = 3;
let InvalidCredentialCodes = dynamic(["50126"]);
let Input = datatable(TimeGenerated:datetime, IPAddress:string, UserPrincipalName:string, ResultType:string)
[
  datetime(2026-09-28T12:00:00Z), "203.0.113.10", "a@example.com", "50126",
  datetime(2026-09-28T12:01:00Z), "203.0.113.10", "b@example.com", "50126",
  datetime(2026-09-28T12:02:00Z), "203.0.113.10", "c@example.com", "50126",
  datetime(2026-09-28T12:03:00Z), "198.51.100.10", "d@example.com", "50126"
];
let Detection = Input
| where ResultType in (InvalidCredentialCodes)
| summarize FailedUsers=dcount(UserPrincipalName) by IPAddress
| where FailedUsers >= UserThreshold;
print TestPassed=toscalar(Detection | count) == 1
